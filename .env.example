# Public canonical URL used by metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://puremotiongolf.com

# Supabase Auth and Data API. Use the publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key used for private Order of Merit player-photo uploads.
# Never prefix this variable with NEXT_PUBLIC_ and never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Registration receipt and operations-notification emails (Resend REST API).
RESEND_API_KEY=re_your_api_key
REGISTRATION_FROM_EMAIL=Pure Motion Golf <registrations@your-verified-domain.example>
REGISTRATION_TEAM_EMAIL=registrations@puremotiongolf.com

# Keep social buttons disabled until the matching provider is fully configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Server-only Yoco Checkout API configuration. Test is the safe default.
YOCO_MODE=test
YOCO_SECRET_KEY=sk_test_replace_me
YOCO_WEBHOOK_SECRET=whsec_replace_me
# Generate a separate random secret of at least 32 characters for private payment links.
PAYMENT_LINK_SECRET=replace_with_a_random_secret_at_least_32_characters
